# kfcollect configuration. Installed to /etc/kfcollect/config.env (readable by root and kfcollect only).
# After editing: sudo systemctl restart kfcollect

# --- Discord ---------------------------------------------------------------------
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
KF_DISCORD_WEBHOOK_URL=
# Status summary every N hours (alerts are sent immediately regardless).
KF_SUMMARY_EVERY_HOURS=6

# --- What to collect --------------------------------------------------------------------
# Focus routes get status lines and "no buses" alerts:
# Inside Loop, Outside Loop, Mesa Loop.
KF_FOCUS_ROUTES=UCSD_1040,UCSD_1030,UCSD_1050
# Also collected (cheap, and live data can't be collected later): SIO, Grocery-Convoy, Regents,
# MTS SuperLoop 201/202/204, MTS 30/41/237, Blue Line trolley (MTS_510), NCTD 101.
KF_EXTRA_ROUTES=UCSD_1020,UCSD_1060,UCSD_1010,MTS_201,MTS_202,MTS_204,MTS_30,MTS_41,MTS_237,MTS_510,NCTD_301

KF_POLL_INTERVAL_S=30
# When no route lists any trip for 2 minutes (overnight), poll this often instead; back to 30 s as soon
# as a trip appears. Worst case, the first minute or two of the first morning trip is polled less often.
KF_IDLE_POLL_INTERVAL_S=120
# Predicted arrivals at each focus-route stop, one full pass per interval (0 disables). Skipped at night.
KF_ARRIVALS_INTERVAL_S=120
# Triton Transit's official GTFS-Realtime feeds, stored raw (0 disables).
KF_GTFS_RT_INTERVAL_S=30

# --- OneBusAway ---------------------------------------------------------------------------
# Default: the keyless proxy behind the public Wayfinder site (undocumented; may change).
KF_OBA_BASE_URL=https://wayfinder.ucsd.onebusawaycloud.com/api/oba/
KF_OBA_FLAVOR=wayfinder
# With an API key from the region's OneBusAway operator, switch to the documented API:
#   KF_OBA_BASE_URL=https://api.san-diego.onebusawaycloud.com/api/where/
#   KF_OBA_FLAVOR=standard
#   KF_OBA_API_KEY=your-key
KF_OBA_API_KEY=

# Triton Transit public GTFS (static + realtime), published by Spare.
KF_GTFS_BASE=https://api.us.sparelabs.com/v1/fixedRoute/public/21c87bba-e136-41bc-ba9a-191bdb3e08e4

# --- Storage -------------------------------------------------------------------------------
KF_DATA_DIR=/var/lib/kfcollect
# Keep raw gzipped responses this many days (0 = forever). Raw days are also pruned, oldest first,
# whenever free space drops below KF_MIN_FREE_GB (the parsed SQLite tables are never pruned).
KF_RAW_KEEP_DAYS=0
KF_MIN_FREE_GB=2

# --- Analysis ----------------------------------------------------------------------------------
KF_TIMEZONE=America/Los_Angeles
# Weekday window when the focus routes should have buses ("no vehicles" alert). GTFS holidays are skipped.
KF_SERVICE_START=07:00
KF_SERVICE_END=22:00
# Agencies whose schedule times are wall-clock from midnight. On daylight-saving days OneBusAway is then
# an hour off (seen Nov 1, 2026 for UCSD only: deviations of -3600 s); derived delays correct for it.
KF_WALLCLOCK_AGENCIES=UCSD
# Trip delay level boundaries in seconds: early < -60 <= on time <= 120 < late <= 300 < very late
# (intervals_5min.delay_level; schedule adherence, kept for comparison).
KF_DEVIATION_LEVELS=-60,120,300
# Excess wait level boundaries in seconds, the interval HMM's observation (intervals_5min.level):
# shorter < -60 <= normal <= 120 < longer <= 300 < much longer than the timetable's wait.
KF_WAIT_LEVELS=-60,120,300
# Delay-gained-per-segment bin edges in seconds: <=0, 0-30, 30-90, 90-180, >180.
KF_GAINED_BINS=0,30,90,180
